# Copy to .env and replace placeholders. Never publish .env.
BOT_TOKEN=CHANGE_ME_FROM_BOTFATHER
# Can be empty: startup reads the real username from Telegram.
BOT_USERNAME=
ADMIN_IDS=CHANGE_ME_NUMERIC_USER_IDS
ADMIN_CHAT_ID=CHANGE_ME_NUMERIC_ADMIN_GROUP_ID
CHANNEL_ID=CHANGE_ME_NUMERIC_CHANNEL_ID
CHANNEL_URL=https://t.me/CHANGE_ME_CHANNEL
# Defaults to CHANNEL_ID if omitted. Requests can use a different group.
# REQUEST_CHAT_ID=-1001234567890
# REQUIRED_CHAT_ID=-1001234567890
# REQUIRED_CHAT_URL=https://t.me/CHANGE_ME_REFERRAL_CHANNEL
SUPPORT_URL=https://t.me/CHANGE_ME_SUPPORT
SUBSCRIPTION_PRICE=400
SUBSCRIPTION_DAYS=7
REFERRAL_GOAL=10
PAYMENT_DETAILS=CHANGE_ME_REAL_BANK_AND_RECIPIENT_DETAILS
# Optional: reply /fileid to a QR photo in the bot to obtain this.
PAYMENT_QR_FILE_ID=
DB_PATH=data/rentbot.sqlite3
